{
  "name": "mission-control", "version": "0.1.0", "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:server": "pnpm --filter @mission/server dev",
    "dev:extension": "pnpm --filter @mission/extension dev",
    "build": "pnpm --filter @mission/extension build && pnpm --filter @mission/server build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "db:migrate": "pnpm --filter @mission/server db:migrate",
    "pairing-code": "tsx scripts/pairing-code.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2", "@types/chrome": "0.1.36", "@types/express": "5.0.6", "@types/node": "24.12.0", "@types/pg": "8.18.0", "@types/react": "19.2.14", "@types/react-dom": "19.2.3", "@vitejs/plugin-react": "5.1.4", "jsdom": "28.1.0", "tsx": "4.21.0", "typescript": "5.9.3", "vite": "7.3.1", "vitest": "4.0.18"
  },
  "pnpm": { "overrides": { "@ag-ui/client": "0.0.59" }, "onlyBuiltDependencies": ["esbuild", "@swc/core"] }
}
