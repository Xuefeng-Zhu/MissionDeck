# Explicit choices; live requests never fall back to fixture success.
PROVIDER_MODE=fixture
MODEL_MODE=fixture
# Live model vendor is independent of task PROVIDER_MODE.
MODEL_PROVIDER=openrouter
COPILOTKIT_TELEMETRY_DISABLED=true
DATABASE_MODE=pglite
DATA_DIR=.data
PORT=4318
# Local mode refuses non-loopback hosts. Hosted mode binds 0.0.0.0 by default
# and requires PostgreSQL; override SERVER_HOST only for a controlled runtime.
DEPLOYMENT_MODE=local
SERVER_HOST=
# The hosted public demo issues isolated four-hour sessions, never external
# provider credentials. Keep PROVIDER_MODE=fixture whenever this is enabled.
PUBLIC_DEMO_ENABLED=false
PUBLIC_DEMO_MAX_MISSIONS=1
PUBLIC_DEMO_MAX_CONCURRENT=4
PUBLIC_DEMO_SESSION_LIMIT=3
PUBLIC_DEMO_MAX_SOURCE_REVISIONS=2
PUBLIC_DEMO_MAX_MODEL_CALLS=20
PUBLIC_DEMO_DAILY_MODEL_LIMIT=200
# Copy this file to .env. Generate a secret with: openssl rand -hex 24
# With no configured code, the server generates .data/pairing-code (0600).
PAIRING_CODE=
# Standard PostgreSQL: DATABASE_MODE=postgres plus this local connection.
DATABASE_URL=postgresql://mission:mission@127.0.0.1:54329/mission_control
# Set only server-side. MODEL_MODE=live enables the selected model vendor.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6-luna
# Optional direct OpenAI path: set MODEL_PROVIDER=openai explicitly.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Workspace/task writes are separate: set PROVIDER_MODE=live and verify identity first.
AMBIGUOUS_API_KEY=
AMBIGUOUS_EXPECTED_USER_ID=
AMBIGUOUS_EXPECTED_WORKSPACE_ID=
# Successful pairing registers the exact extension origin; optional explicit allowlist below.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Optional fixed demo clock, not an actual event deadline.
# Domain test/demo factory clock only. Running server uses real approval expiry.
# DEMO_NOW=2026-09-12T16:00:00.000Z
# Phase two stays disabled until core live acceptance is verified.
TRIGGER_SECRET_KEY=
EXA_API_KEY=

# Incremental workspace controls; no native automation is activated by startup.
WORKSPACE_UPGRADE_ENABLED=true
# Browser context defaults: selected tab limit 5, page limit 20000, request limit 50000.
# Live Assist starts paused; consent is memory-only and must be renewed after restart.
# Temporary server context expires after 10 minutes (purged each minute while running).
# Native activation stays blocked until node schemas and scope enforcement are verified.
